# Copy to .env and replace paths locally. Never commit credentials.
BE_SAFETY_BEDICT_REPO=/path/to/bedict
BE_SAFETY_BEDICT_PYTHON=/path/to/bedict/.venv/bin/python
BE_SAFETY_CRISPOR_REPO=/path/to/crispor
BE_SAFETY_CRISPOR_PYTHON=/path/to/crispor/.venv/bin/python
BE_SAFETY_CRISPOR_GENOME=hg38
BE_SAFETY_CRISPOR_GENOMEDIR=/path/to/crispor/genomes
BE_SAFETY_CRISPOR_PAM=NGG
BE_SAFETY_CRISPRON_ABE_REPO=/path/to/crispron-BE
BE_SAFETY_CRISPRON_ABE_PYTHON=/path/to/crispronbe/bin/python
